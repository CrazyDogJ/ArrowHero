; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="ArrowHero"
config/description="A little game that using arrow to beat enemies."
config/version="0.1"
run/main_scene="uid://dfxi7mb7mvf7v"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="uid://bomrolqwsgv12"

[autoload]

GameplayCueManager="*uid://bh6ixabs0w700"
RandomGenerator="*uid://b3egmx41ktxpp"
InputSettings="*uid://bp7tbh301b08b"
GlobalVars="*uid://dhu6gbr8e2wup"
LoadingScreenManager="*uid://bdlf1qgrbar0b"
SaveGameManager="*uid://d2uigj5l7p74m"

[debug]

gdscript/warnings/unused_parameter=0

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/GodotGAS/plugin.cfg", "res://addons/gd_override_functions/plugin.cfg", "res://addons/gdscript_refactoring/plugin.cfg", "res://addons/script-ide/plugin.cfg", "res://addons/tres_localization/plugin.cfg")

